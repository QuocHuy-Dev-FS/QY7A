# Supabase Public Configuration (bắt buộc cho cả Client và Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Hoặc hỗ trợ Anon Key cũ:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Danh sách email cán bộ quản trị được cấp quyền truy cập trang Admin (phân tách bởi dấu phẩy)
QUALITY_ADMIN_EMAILS=admin@gmail.com,quanly@bvquany7a.vn

# Supabase Service Role Key (chỉ dùng bí mật trên Server, tuyệt đối không thêm tiền tố NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
